% -----------------------------------------------------------------------------
% Metadata & Wordmark
% -----------------------------------------------------------------------------
\newcommand{\UpGradModule}{}
\newcommand{\UpGradDeckKind}{}
\newcommand{\DeckMetadata}[2]{\gdef\UpGradModule{#1}\gdef\UpGradDeckKind{#2}}
\newcommand{\UpGradWordmark}{%
  {\UpGradDisplayFont\fontsize{11}{13}\selectfont\bfseries\color{UpGradNight}up\textcolor{UpGradRed}{Grad}}%
}

% -----------------------------------------------------------------------------
% Frametitle & Footline (Streamlined & Collision-Free)
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace{0.18cm}%
  {\UpGradDisplayFont\fontsize{15}{18}\selectfont\bfseries\color{UpGradNight}\insertframetitle}\par
  \vspace{0.08cm}%
  \textcolor{UpGradRed}{\rule{1.40cm}{2.0pt}}\textcolor{AWSOrange}{\rule{0.60cm}{2.0pt}}\textcolor{UpGradRule}{\rule{\dimexpr\textwidth-2.00cm\relax}{0.4pt}}\vspace{-0.02cm}
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
    \begin{beamercolorbox}[wd=.68\paperwidth,ht=0.36cm,dp=0.12cm,leftskip=.72cm]{author in head/foot}%
      \scriptsize\bfseries\color{UpGradSlate}\UpGradModule\ifstrempty{\UpGradDeckKind}{}{\enspace{\color{UpGradRed}\textbar}\enspace\color{UpGradInk}\UpGradDeckKind}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=0.36cm,dp=0.12cm,rightskip=.72cm plus 1fill]{date in head/foot}%
      \hfill%
      \UpGradWordmark\enspace{\color{UpGradRed}\textbar}\enspace{\scriptsize\bfseries\color{UpGradSlate}\insertframenumber}%
    \end{beamercolorbox}%
  }\vskip0.12cm%
}

\graphicspath{{../../../theme/assets/}{../../theme/assets/}{../theme/assets/}{theme/assets/}{assets/}}

\newcommand{\AWSLogoWhite}[1][0.48cm]{%
  \raisebox{-0.13cm}{\includegraphics[height=#1]{aws_logo_white.pdf}}%
}
\newcommand{\AWSLogoDark}[1][0.48cm]{%
