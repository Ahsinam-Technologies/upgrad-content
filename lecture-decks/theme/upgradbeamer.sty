% 1. Visual-Dominant Canvas (Figure takes 60-65% width, Side Narrative takes 35-40%)
\newcommand{\VisualExploration}[4][.62]{%
  \begin{columns}[c,onlytextwidth]%
    \begin{column}{#1\textwidth}%
      \centering #2%
    \end{column}%
    \hfill%
    \begin{column}{\dimexpr\textwidth-#1\textwidth-0.03\textwidth\relax}%
      {\small\bfseries\color{UpGradNight}#3}\par\vspace{0.12cm}%
      {\footnotesize\color{UpGradInk}#4}%
    \end{column}%
  \end{columns}%
}

% 2. Mathematical Hero & Geometric Core (Monumental Equation + Analytical Takeaway)
\newcommand{\MathematicalHero}[3]{%
  \begin{center}%
    \vspace{0.10cm}%
    {\fontsize{18}{22}\selectfont\color{UpGradNight}\(\displaystyle #1\)}\par\vspace{0.22cm}%
    {\small\color{UpGradSlate}#2}%
  \end{center}%
  \vfill%
  \TakeawayBanner{#3}%
}

% 3. Annotated Step Derivation Sequence
\newcommand{\AnnotatedStep}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradMist,colframe=UpGradRule,
    borderline west={2.5pt}{0pt}{UpGradRed},left=3.2mm,right=3.2mm,top=2.0mm,bottom=2.0mm]
    \begin{columns}[c,onlytextwidth]%
      \begin{column}{.14\textwidth}%
        \tcbox[on line,boxsep=0pt,left=4pt,right=4pt,top=1.8pt,bottom=1.8pt,colback=UpGradRed,colframe=UpGradRed,arc=1.0mm]{%
          \scriptsize\bfseries\color{white}STEP #1%
        }%
      \end{column}%
      \begin{column}{.52\textwidth}%
        \centering\small\(\displaystyle #3\)%
      \end{column}%
      \begin{column}{.32\textwidth}%
        {\scriptsize\bfseries\color{UpGradNight}#2}\par\vspace{0.02cm}%
        {\tiny\color{UpGradSlate}#4}%
      \end{column}%
    \end{columns}%
  \end{tcolorbox}%
}

