% -----------------------------------------------------------------------------
% Typography & Font Resolution (Montserrat Display + Plus Jakarta Sans Body)
% -----------------------------------------------------------------------------
\ifXeTeX
  \RequirePackage{fontspec}
  \newcommand{\UpGradFontPath}{}
  \IfFileExists{../../../theme/fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{../../../theme/fonts/}}{%
  \IfFileExists{../../theme/fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{../../theme/fonts/}}{%
  \IfFileExists{../theme/fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{../theme/fonts/}}{%
  \IfFileExists{theme/fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{theme/fonts/}}{%
  \IfFileExists{fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{fonts/}}{%
  \IfFileExists{../../../../theme/fonts/Montserrat-Regular.ttf}{\gdef\UpGradFontPath{../../../../theme/fonts/}}{%
  }}}}}}
  
  \ifx\UpGradFontPath\empty
    \IfFontExistsTF{Plus Jakarta Sans}{%
      \setsansfont[BoldFont=Plus Jakarta Sans Bold,ItalicFont=Plus Jakarta Sans Italic]{Plus Jakarta Sans}
      \newfontfamily\UpGradDisplayFont[BoldFont=Montserrat Bold,ItalicFont=Montserrat Italic]{Montserrat}
    }{%
      \setsansfont{DejaVu Sans}
      \newfontfamily\UpGradDisplayFont{DejaVu Sans}
    }
  \else
    \setsansfont[
      Ligatures=TeX,
      Path=\UpGradFontPath,
      UprightFont=PlusJakartaSans-Regular.ttf,
      BoldFont=PlusJakartaSans-Bold.ttf,
      ItalicFont=PlusJakartaSans-Italic.ttf
    ]{PlusJakartaSans}
    \newfontfamily\UpGradDisplayFont[
      Ligatures=TeX,
      Path=\UpGradFontPath,
      UprightFont=Montserrat-Regular.ttf,
      BoldFont=Montserrat-Bold.ttf,
      ItalicFont=Montserrat-Italic.ttf
    ]{Montserrat}
  \fi
  \setmonofont{DejaVu Sans Mono}[Scale=0.86]
\else
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
  \newcommand{\UpGradDisplayFont}{\sffamily\bfseries}
\fi

