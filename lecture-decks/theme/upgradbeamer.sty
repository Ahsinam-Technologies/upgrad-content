\newcommand{\ContentPendingDeck}[2]{%
  \UpGradTitleSlide{#1: #2}{Instructional content pending approval}{#1}{#2}%
  \begin{frame}{Content Status}
    \begin{WarningBox}{No Approved Lesson Material Supplied}
      This deck is intentionally a source-and-PDF scaffold. Replace it with reviewed learning objectives, AWS architecture patterns, code examples and references before learner delivery.
    \end{WarningBox}
  \end{frame}%
  \begin{frame}{Author Handoff}
    \begin{itemize}
      \item Start from the approved session plan and define observable learning objectives.
      \item Add session-local assets under \InlineCode{assets/}; keep reusable components in the shared theme.
      \item Compile with \InlineCode{make deck DECK=...} and review the resulting PDF before release.
    \end{itemize}
  \end{frame}%
}

