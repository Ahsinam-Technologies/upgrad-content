}

% -----------------------------------------------------------------------------
% Title Page
% -----------------------------------------------------------------------------
\setbeamercolor{title page}{bg=UpGradNight}
\setbeamertemplate{title page}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight,sep=0pt]{title page}%
    \begin{tikzpicture}[remember picture,overlay]
      \fill[UpGradRed] (current page.north west) rectangle ([xshift=.22cm]current page.south west);
      \fill[AWSOrange] ([xshift=.22cm]current page.north west) rectangle ([xshift=.28cm,yshift=-2.2cm]current page.north west);
      \draw[UpGradSlate!25!UpGradNight,line width=.4pt] ([xshift=14.5cm,yshift=-.72cm]current page.north west) -- ([xshift=14.5cm,yshift=-7.02cm]current page.north west);
      \fill[UpGradRed] ([xshift=14.5cm,yshift=-6.95cm]current page.north west) rectangle ([xshift=15.65cm,yshift=-7.02cm]current page.north west);

      % Top header: upGrad on line 1, Program Title with substantial AWS Logo on line 2
      \node[anchor=north west,inner sep=0pt] at ([xshift=0.94cm,yshift=-0.62cm]current page.north west) {%
        \begin{minipage}{0.85\paperwidth}\raggedright
          {\UpGradDisplayFont\fontsize{14}{17}\selectfont\bfseries\color{white}up\textcolor{UpGradRed}{Grad}}\par\vspace{0.14cm}%
          {\fontsize{10.5}{14}\selectfont\color{UpGradMist}Professional Program in Enterprise Data Science \& Agentic AI with\enspace\AWSLogoWhite[0.48cm]}%
        \end{minipage}%
      };

      % Main Title, Subtitle, and decorative bar
      \node[anchor=west,inner sep=0pt] at ([xshift=0.94cm,yshift=0.10cm]current page.west) {%
        \begin{minipage}{0.78\paperwidth}\raggedright
          {\color{UpGradRed}\rule{1.40cm}{2.4pt}}\textcolor{AWSOrange}{\rule{0.60cm}{2.4pt}}\par\vspace{0.32cm}%
          {\UpGradDisplayFont\fontsize{23}{28}\selectfont\bfseries\color{white}\inserttitle\par}%
          \vspace{0.24cm}{\large\color{UpGradMist}\insertsubtitle\par}%
        \end{minipage}%
      };

      % Footer lower on cover page
      \node[anchor=south west,inner sep=0pt] at ([xshift=0.94cm,yshift=0.62cm]current page.south west) {%
        {\scriptsize\bfseries\color{UpGradMuted}\UpGradModule\ifstrempty{\UpGradDeckKind}{}{\enspace{\color{UpGradRed}\textbar}\enspace\UpGradDeckKind}}%
      };
    \end{tikzpicture}%
  \end{beamercolorbox}%
}

% \UpGradTitleSlide{title}{subtitle}{module}{deck kind}
\newcommand{\UpGradTitleSlide}[4]{%
  \title{#1}\subtitle{#2}\DeckMetadata{#3}{#4}%
  \begin{frame}[plain]\titlepage\end{frame}%
}

% -----------------------------------------------------------------------------
% Section / Agenda / Block Dividers
% -----------------------------------------------------------------------------
\newcommand{\AgendaSlide}[1]{%
  \begin{frame}{Session Agenda}\small #1\end{frame}%
}

\newcommand{\BlockEntry}[3]{\item[] \textcolor{UpGradRed}{\bfseries BLOCK #1}\hspace{.35em}\textbf{#2}\par\scriptsize\color{UpGradSlate}#3\normalsize\vspace{.15cm}}
\newcommand{\TopicEntry}[3]{\BlockEntry{#1}{#2}{#3}}

% Disable automatic word hyphenation across slides
\hyphenpenalty=10000
\exhyphenpenalty=10000
\binoppenalty=10000
\relpenalty=10000

\newcommand{\SessionAgendaSlide}[1]{%
  \begin{frame}{Session Agenda}
    \vspace{.02cm}\small\begin{itemize}\setlength{\itemsep}{.12cm}#1\end{itemize}
  \end{frame}%
}
\newcommand{\SessionSummarySlide}[1]{%
  \begin{frame}{Session Summary}
    \vspace{.02cm}\small\begin{enumerate}\setlength{\itemsep}{.08cm}#1\end{enumerate}
    \vfill\Citation{Professional Program in Enterprise Data Science \& Agentic AI with AWS — Modular Session Architecture}
  \end{frame}%
}
\newcommand{\SessionTopicsSlide}[1]{\SessionAgendaSlide{#1}}%

\newcommand{\TopicDivider}[3]{%
  {\setbeamercolor{background canvas}{bg=UpGradNight}%
  \begin{frame}[plain]
    \vspace*{.72cm}\hspace*{.72cm}{\UpGradDisplayFont\color{UpGradRed}\bfseries\large BLOCK\enspace#1}\par
    \vfill\hspace*{.72cm}\begin{minipage}{.80\paperwidth}
      {\UpGradDisplayFont\fontsize{28}{33}\selectfont\bfseries\color{white}#2\par}\vspace{.26cm}
      {\large\color{UpGradMist}#3\par}
    \end{minipage}\vfill
    \hspace*{.72cm}{\scriptsize\bfseries\color{UpGradMuted}\UpGradModule\enspace{\color{UpGradRed}\textbar}\enspace\UpGradDeckKind}\vspace*{.58cm}
  \end{frame}}%
}
\newcommand{\BlockDivider}[3]{\TopicDivider{#1}{#2}{#3}}%

\newcommand{\TopicStandaloneTitle}[3]{%
  \ifSubfilesClassLoaded{%
    \title{Topic #1: #2}\subtitle{#3}\gdef\UpGradDeckKind{Topic #1}%
    \begin{frame}[plain]\titlepage\end{frame}%
  }{}%
}

\newcommand{\SectionDivider}[3]{%
  \begin{frame}[plain]
    \vfill
    {\UpGradDisplayFont\color{UpGradRed}\bfseries\large SECTION\enspace#1}\par\vspace{0.20cm}
    {\UpGradDisplayFont\fontsize{24}{29}\selectfont\bfseries\color{UpGradNight}#2\par}\vspace{0.24cm}
    {\large\color{UpGradSlate}#3\par}
    \vfill
  \end{frame}%
}

% -----------------------------------------------------------------------------
% Specialized UI & Pedagogical Components for Data Science on AWS
% -----------------------------------------------------------------------------

% 1. Inline Pill Badge
\newcommand{\PillBadge}[2][UpGradRed]{%
  \tcbox[on line,boxsep=0pt,left=4pt,right=4pt,top=1.8pt,bottom=1.8pt,
    colback=#1!12!white,colframe=#1!70!white,arc=1.0mm,boxrule=.4pt]{%
    \tiny\bfseries\color{#1}#2%
  }%
}

% 2. Executive Stat / Performance Card
% Usage: \StatCard{AWSOrange}{3,500}{PUT req/sec}{S3 Standard partition rate}
\newcommand{\StatCard}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradMist,colframe=UpGradRule,
    borderline north={2.2pt}{0pt}{#1},left=2.6mm,right=2.6mm,top=2.0mm,bottom=2.0mm]
    {\UpGradDisplayFont\fontsize{18}{20}\selectfont\bfseries\color{#1}#2}\par\vspace{0.04cm}
    {\scriptsize\bfseries\color{UpGradNight}#3}\par\vspace{0.02cm}
    {\tiny\color{UpGradSlate}#4}
  \end{tcolorbox}%
}

% 3. AWS Service Architecture Container Card
% Usage: \AWSServiceCard{Amazon S3}{STORAGE}{Distributed object store with 99.999999999% durability.}{Core Lake}
\newcommand{\AWSServiceCard}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradMist,colframe=UpGradRule,
    borderline west={2.5pt}{0pt}{AWSOrange},left=3.2mm,right=3.2mm,top=2.0mm,bottom=2.0mm,
    title={{\UpGradDisplayFont\bfseries\color{AWSSquid}#1}\hfill\PillBadge[AWSOrange]{#2}},coltitle=AWSSquid]
    \vspace{0.04cm}
    {\scriptsize\color{UpGradInk}#3}\par\vspace{0.06cm}
    {\tiny\bfseries\color{UpGradSlate}Tier:\enspace\color{AWSBlue}#4}
  \end{tcolorbox}%
}

% 4. Comparative Architecture / Trade-off Grid
% Usage: \CompareGrid{Amazon Athena}{Serverless interactive SQL...}{Amazon Redshift}{Columnar data warehouse...}
\newcommand{\CompareGrid}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradMist,colframe=UpGradRule,
    left=3.0mm,right=3.0mm,top=2.2mm,bottom=2.2mm]
    \begin{columns}[T,onlytextwidth]%
      \begin{column}{.48\textwidth}%
        {\UpGradDisplayFont\small\bfseries\color{AWSBlue}#1}\par\vspace{0.08cm}
        {\scriptsize\color{UpGradInk}#2}%
      \end{column}%
      \hfill{\color{UpGradRule}\vrule width .4pt}\hfill%
      \begin{column}{.48\textwidth}%
        {\UpGradDisplayFont\small\bfseries\color{UpGradRed}#3}\par\vspace{0.08cm}
        {\scriptsize\color{UpGradInk}#4}%
      \end{column}%
    \end{columns}%
  \end{tcolorbox}%
}

% 5. Technical Pipeline & Architecture Diagram Box
% Usage: \ArchitectureCard{Glue ETL to Redshift Pipeline}{<TikZ>}{Zero-copy Spectrum integration}
\newcommand{\ArchitectureCard}[3]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradCanvas,colframe=UpGradRule,
    borderline west={2.5pt}{0pt}{UpGradRed},left=3.2mm,right=3.2mm,top=2.0mm,bottom=2.0mm,
    title={{\UpGradDisplayFont\bfseries\color{UpGradNight}#1}\hfill\PillBadge[UpGradRed]{PIPELINE}},coltitle=UpGradNight]
    \centering\vspace{.05cm}
    #2\par\vspace{.08cm}
    \flushleft{\scriptsize\color{UpGradSlate}#3}
  \end{tcolorbox}%
}

% 6. Mathematical Derivation & Algorithm Step Container
% Usage: \MathDerivationStep{1}{\mathcal{L}_{\text{XGB}} = \sum_i l(y_i, \hat{y}^{(t-1)}_i + f_t(x_i)) + \Omega(f_t)}{Second-order Taylor expansion}
\newcommand{\MathDerivationStep}[3]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradMist,colframe=UpGradRule,
    left=3.2mm,right=3.2mm,top=1.8mm,bottom=1.8mm]
    \begin{columns}[c,onlytextwidth]%
      \begin{column}{.12\textwidth}%
        \tcbox[on line,boxsep=0pt,left=3.5pt,right=3.5pt,top=1.5pt,bottom=1.5pt,colback=UpGradRed,colframe=UpGradRed,arc=1.0mm]{%
          \scriptsize\bfseries\color{white}STEP #1%
        }%
      \end{column}%
      \begin{column}{.54\textwidth}%
        \centering\small\(\displaystyle #2\)%
      \end{column}%
      \begin{column}{.32\textwidth}%
        {\scriptsize\color{UpGradSlate}#3}%
      \end{column}%
    \end{columns}%
  \end{tcolorbox}%
}

% 7. High-Impact Operational Takeaway Banner
% Usage: \TakeawayBanner{Always partition S3 prefixes by YYYY/MM/DD to avoid hot-partition request throttling.}
\newcommand{\TakeawayBanner}[1]{%
  \begin{tcolorbox}[enhanced,arc=1.4mm,boxrule=.45pt,colback=UpGradNight,colframe=AWSSquid,
    left=3.2mm,right=3.2mm,top=2.0mm,bottom=2.0mm]
    \begin{columns}[c,onlytextwidth]%
      \begin{column}{.18\textwidth}%
        \tcbox[on line,boxsep=0pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt,colback=UpGradRed,colframe=UpGradRedGlow,arc=1.0mm]{%
          \scriptsize\bfseries\color{white}Important%
        }%
      \end{column}%
      \begin{column}{.80\textwidth}%
        \small\bfseries\color{UpGradMist}#1%
      \end{column}%
    \end{columns}%
  \end{tcolorbox}%
}

